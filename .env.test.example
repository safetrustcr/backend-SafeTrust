# ============================================================
# SafeTrust — Test Environment Variables
# Copy this file to .env.test and adjust as needed.
#   cp .env.test.example .env.test
# ============================================================

# ── Test Secrets ──────────────────────────────────────────────
# Hasura admin secret for the test GraphQL Engine
TEST_ADMIN_SECRET=myadminsecretkey

# Must contain only URI-safe characters (no @, /, :, ?) since it is
# interpolated directly into postgres:// connection strings.
# PostgreSQL password for the test database
TEST_POSTGRES_PASSWORD=postgrespassword

# Webhook HMAC shared secret (used by TRUSTLESSWORK_WEBHOOK_SECRET)
TEST_WEBHOOK_SECRET=dev-secret

# JWT secret used by Hasura (used by JWT_SECRET in Karate)
TEST_JWT_SECRET=testsecret

# ── Test Ports ────────────────────────────────────────────────
# Port exposed on the host for the test PostgreSQL
TEST_POSTGRES_PORT=5434

# Port exposed on the host for the test Hasura GraphQL Engine
TEST_HASURA_PORT=8081

# Port exposed on the host for the test webhook
TEST_WEBHOOK_PORT=3001
