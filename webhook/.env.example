# Hasura admin secret used for GraphQL requests. Required at runtime; inject it
# from your secret manager and never commit a real value.
HASURA_ADMIN_SECRET=

# Shared secret for TrustlessWork escrow webhook HMAC-SHA256 verification
# (consumed by the Rust Neon verifier). Also send x-trustlesswork-timestamp
# as unix epoch milliseconds; callbacks older than 5 minutes are rejected.
TRUSTLESSWORK_WEBHOOK_SECRET=your-trustlesswork-webhook-secret-here

INTERNAL_SERVICE_SECRET=your-internal-secret-here

# Enable Soroban RPC blockchain validation pass in sync-escrows
SOROBAN_VALIDATION_ENABLED=false

# Stellar network for Soroban RPC queries
STELLAR_NETWORK=testnet

# Override default Soroban RPC endpoint
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# SHA-256 of the raw proof_of_funds verification-key artifact. Mandatory by
# default (production, staging, or unset NODE_ENV) to prevent circuit substitution attacks.
# Exempt only in explicit development and test environments to facilitate local iteration.
ZK_PROOF_OF_FUNDS_VK_SHA256=

# Feature flag for mandatory real-funds ZK eligibility enforcement at escrow
# initialization. Defaults to false. Real-funds ZK enforcement remains disabled
# until the chosen attested/ledger approach is fully implemented (ZK-02..ZK-09).
ZK_ENFORCEMENT_ENABLED=false

