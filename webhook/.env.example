# Hasura admin secret used for GraphQL requests. Required at runtime; inject it
# from your secret manager and never commit a real value.
HASURA_ADMIN_SECRET=

# Trustless Work V1 API: testnet https://dev.api.trustlesswork.com (default),
# mainnet https://api.trustlesswork.com. The key is sent as `x-api-key`.
# The older TRUSTLESS_WORK_API_* spelling still works but logs a warning.
TRUSTLESSWORK_API_URL=https://dev.api.trustlesswork.com
TRUSTLESSWORK_API_KEY=

# Shared secret the Hasura reconciliation cron trigger sends as
# `x-hasura-event-secret` on POST /reconciliation/sync-escrows. Required in
# production: the webhook refuses to start with NODE_ENV=production when it
# is missing. In development, leave this unset or empty to run the endpoint
# unauthenticated. Do NOT keep a placeholder value here: any non-empty value
# is treated as a real secret and the endpoint will require it. To run
# authenticated in development, set a value matching the one Hasura sends.
# Note: bin/start requires this variable, so the full stack cannot start
# with it unset. Set any value there instead (it must match Hasura's).
HASURA_EVENT_SECRET=

# Enable Soroban RPC blockchain validation pass in sync-escrows
SOROBAN_VALIDATION_ENABLED=false

# Stellar network for Soroban RPC queries
STELLAR_NETWORK=testnet

# Override default Soroban RPC endpoint
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Tenant for signed Trustless Work webhooks and for sessions whose verified
# token carries no tenant claim. Defaults to safetrust.
PLATFORM_TENANT_ID=safetrust

# Browser origins allowed by CORS, comma-separated exact origins. Unset in
# production allows none; unset elsewhere allows localhost / 127.0.0.1 only.
# `*` allows any origin and must be a deliberate choice.
CORS_ALLOWED_ORIGINS=

# debug | info | warn | error | silent. Logs are JSON, one object per line.
LOG_LEVEL=info
