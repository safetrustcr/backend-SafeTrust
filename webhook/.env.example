# Hasura admin secret used for GraphQL requests. Required at runtime; inject it
# from your secret manager and never commit a real value.
HASURA_ADMIN_SECRET=

# Trustless Work V1 API: testnet https://dev.api.trustlesswork.com (default),
# mainnet https://api.trustlesswork.com. The key is sent as `x-api-key`.
# The older TRUSTLESS_WORK_API_* spelling still works but logs a warning.
TRUSTLESSWORK_API_URL=https://dev.api.trustlesswork.com
TRUSTLESSWORK_API_KEY=

# Stellar network (testnet | mainnet) for wallet challenges, transaction
# confirmation and x402.
STELLAR_NETWORK=testnet

# External HTTP timeouts, in milliseconds. Override per upstream; invalid
# values fall back to the defaults.
# - Horizon transaction lookup (default 10000): single-record read by hash.
#   HORIZON_BASE_URL overrides the Horizon instance entirely; by default it
#   is picked from STELLAR_NETWORK.
HORIZON_TIMEOUT_MS=10000
# - Trustless Work indexer read (default 30000): reads a chunk of escrows
#   with validateOnChain=true, so it gets the longest budget.
TRUSTLESSWORK_INDEXER_TIMEOUT_MS=30000
# - Trustless Work indexer/update-from-txHash (default 15000): one escrow.
TRUSTLESSWORK_INDEXER_UPDATE_TIMEOUT_MS=15000
# - Trustless Work helper/send-transaction (default 15000): submits a
#   signed XDR to the network. A timeout here is ambiguous (the tx may
#   have been submitted); it reconciles through the confirmation retry
#   table and never blind-resends.
TRUSTLESSWORK_SEND_TRANSACTION_TIMEOUT_MS=15000

# Tenant for signed Trustless Work webhooks and for sessions whose verified
# token carries no tenant claim. Defaults to safetrust.
PLATFORM_TENANT_ID=safetrust

# Browser origins allowed by CORS, comma-separated exact origins. Unset in
# production allows none; unset elsewhere allows localhost / 127.0.0.1 only.
# `*` allows any origin and must be a deliberate choice.
CORS_ALLOWED_ORIGINS=

# debug | info | warn | error | silent. Logs are JSON, one object per line.
LOG_LEVEL=info

# ── x402 Payments ──────────────────────────────────────────────
# Enable x402 payments on /api/escrows/initialize. Defaults to false.
# Set to true once SAFETRUST_PLATFORM_WALLET and facilitator are configured.
X402_ENABLED=false

# x402 Facilitator endpoint.
# Testnet default: https://x402.org/facilitator (open, fee-sponsored)
# Mainnet: must be configured by operator (e.g. OpenZeppelin Channels)
X402_FACILITATOR_URL=https://x402.org/facilitator

# Optional API key for facilitator authentication (e.g. OpenZeppelin Channels)
X402_FACILITATOR_API_KEY=

# SafeTrust platform wallet public key to receive booking fees.
# Must be a valid Stellar Ed25519 public key with a USDC trustline.
# Obvious placeholder below will fail startup validation if left unedited when X402_ENABLED=true.
SAFETRUST_PLATFORM_WALLET=G_YOUR_PLATFORM_WALLET_PUBLIC_KEY

# Express proxy trust: false by default. Set to a hop count (for example 1)
# only when deployed behind that many trusted reverse proxies.
TRUST_PROXY=

# Per-process in-memory rate limits. Values are requests per window.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100
API_IP_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
AUTH_IP_RATE_LIMIT_MAX=300
PUBLIC_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_RATE_LIMIT_MAX=60
HEALTH_RATE_LIMIT_WINDOW_MS=900000
HEALTH_RATE_LIMIT_MAX=600
