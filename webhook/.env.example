# Shared secret for TrustlessWork escrow webhook HMAC-SHA256 verification
# (consumed by the Rust Neon verifier). Also send x-trustlesswork-timestamp
# as unix epoch milliseconds; callbacks older than 5 minutes are rejected.
TRUSTLESSWORK_WEBHOOK_SECRET=your-trustlesswork-webhook-secret-here

INTERNAL_SERVICE_SECRET=your-internal-secret-here

# Enable Soroban RPC blockchain validation pass in sync-escrows
SOROBAN_VALIDATION_ENABLED=false

# Stellar network for Soroban RPC queries
STELLAR_NETWORK=testnet

# Override default Soroban RPC endpoint
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# SHA-256 of the raw proof_of_funds verification-key artifact. Set this in
# production to prevent accepting a proof made for a different Noir circuit.
ZK_PROOF_OF_FUNDS_VK_SHA256=
