{
  "scripts": {
    "build:rust": "npm run build:tooling && cargo build --release --manifest-path ../crates/Cargo.toml -p x402-processor && node ../crates/scripts/copy-native.js --crate=x402-processor",
    "build": "npm run build:rust && tsc",
    "dev": "nodemon --exec ts-node src/index.ts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p ../tsconfig.crates.json --noEmit && tsc -p ../tests/karate/tsconfig.json --noEmit && tsc -p ../tests/karate/tsconfig.helpers.json --noEmit",
    "test": "npm run build:rust && jest",
    "test:ci": "jest --runInBand",
    "test:watch": "jest --watch",
    "build:tooling": "tsc -p ../tsconfig.crates.json",
    "build:karate": "tsc -p ../tests/karate/tsconfig.json && tsc -p ../tests/karate/tsconfig.helpers.json"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.130",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 30000,
    "workerIdleMemoryLimit": "512MB",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest",
      "^.+\\.js$": [
        "ts-jest",
        {
          "isolatedModules": true,
          "tsconfig": {
            "allowJs": true
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(uint8array-extras|@exodus/bytes|@noble/hashes|@noble/ed25519)/)(?!.*/node_modules/)"
    ]
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0"
  }
}
