{
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --exec ts-node src/index.ts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p ../tsconfig.crates.json --noEmit && tsc -p ../tests/karate/tsconfig.json --noEmit && tsc -p ../tests/karate/tsconfig.helpers.json --noEmit",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "test:watch": "jest --watch",
    "build:tooling": "tsc -p ../tsconfig.crates.json",
    "build:karate": "tsc -p ../tests/karate/tsconfig.json && tsc -p ../tests/karate/tsconfig.helpers.json"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "lockfile-lint": "5.1.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 30000,
    "workerIdleMemoryLimit": "512MB",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests/integration"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest",
      "^.+\\.js$": [
        "ts-jest",
        {
          "isolatedModules": true,
          "tsconfig": {
            "allowJs": true
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(@stellar|@noble|@exodus|@x402|uint8array-extras)/)(?!.*/node_modules/)"
    ]
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "@x402/core": "^2.31.0",
    "@x402/express": "^2.31.0",
    "@x402/stellar": "^2.31.0",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.5",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0"
  }
}
