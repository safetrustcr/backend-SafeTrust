#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$ROOT_DIR"

# Load .env file if available
if [ -f .env ]; then
  export $(grep -v '^#' .env | xargs)
fi

HASURA_ADMIN_SECRET="${HASURA_GRAPHQL_ADMIN_SECRET:-myadminsecretkey}"
HASURA_PORT="${HASURA_PORT:-8080}"
POSTGRES_PORT="${POSTGRES_PORT:-5433}"
WEBHOOK_PORT="${WEBHOOK_PORT:-3000}"
HASURA_ENDPOINT="http://localhost:${HASURA_PORT}"

RESET_DATABASE=false
RESTART_CONTAINERS=false
TENANTS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --reset)
      RESET_DATABASE=true
      shift
      ;;
    --restart)
      RESTART_CONTAINERS=true
      shift
      ;;
    -h|--help)
      cat <<'USAGE'
Usage: bin/start [--reset] [--restart] <tenant1> [tenant2 ...]

Options:
  --reset    Stop the stack and remove its volumes before starting.
  --restart  Recreate the containers while preserving volumes.
  -h, --help Show this help.
USAGE
      exit 0
      ;;
    -* )
      echo "❌ Error: Unknown option: $1"
      echo "   Run 'bin/start --help' for usage."
      exit 1
      ;;
    *)
      TENANTS+=("$1")
      shift
      ;;
  esac
done

if [[ "$RESET_DATABASE" == "true" && "$RESTART_CONTAINERS" == "true" ]]; then
  echo "❌ Error: --reset and --restart cannot be used together."
  exit 1
fi

if [[ "${#TENANTS[@]}" -eq 0 ]]; then
  cat <<'USAGE'
Usage: bin/start [--reset] [--restart] <tenant1> [tenant2 ...]

Options:
  --reset    Stop the stack and remove its volumes before starting.
  --restart  Recreate the containers while preserving volumes.
  -h, --help Show this help.

Example:
  bin/start --restart safetrust hotel_industry
USAGE
  exit 0
fi

TRACK_SAFETRUST_TIMINGS=false
if [[ "${#TENANTS[@]}" -eq 1 && "${TENANTS[0]}" == "safetrust" ]]; then
  TRACK_SAFETRUST_TIMINGS=true
  TIMER_START=$SECONDS
fi

echo ""
echo "🚀 Starting SafeTrust backend..."
echo "   Tenants to deploy: ${TENANTS[*]}"
echo ""


# ── 1. Start containers ───────────────────────────────────────────────────────
if [[ "$RESET_DATABASE" == "true" ]]; then
  echo "🧹 Resetting containers and database volumes..."
  docker compose down -v
elif [[ "$RESTART_CONTAINERS" == "true" ]]; then
  echo "🔄 Restarting containers (preserving database volumes)..."
  docker compose down
fi

echo "📦 Starting containers..."
docker compose up -d --build

if [[ "$TRACK_SAFETRUST_TIMINGS" == "true" ]]; then
  TIMING_DOCKER_UP=$((SECONDS - TIMER_START))
fi

# ── 2. Wait for Hasura to be healthy ─────────────────────────────────────────
echo "⏳ Waiting for Hasura to be healthy on ${HASURA_ENDPOINT}..."

MAX_WAIT_SECONDS=120
POLL_INTERVAL=0.5
START_TS=$SECONDS
until curl -sf "${HASURA_ENDPOINT}/healthz" > /dev/null 2>&1; do
  ELAPSED=$((SECONDS - START_TS))
  if [[ "$ELAPSED" -ge "$MAX_WAIT_SECONDS" ]]; then
    echo "❌ Hasura health check timed out after ${MAX_WAIT_SECONDS}s"
    echo "   Last Hasura response:"
    curl -s "${HASURA_ENDPOINT}/healthz" || true
    exit 1
  fi
  # Progress indicator every 5 seconds
  if (( ELAPSED % 5 == 0 && ELAPSED > 0 )); then
    echo "   ⏳ Still waiting... (${ELAPSED}s elapsed)"
  fi
  sleep "$POLL_INTERVAL"
done
HASURA_READY_AT=$((SECONDS - START_TS))
echo "✅ Hasura is healthy (ready in ${HASURA_READY_AT}s)"

if [[ "$TRACK_SAFETRUST_TIMINGS" == "true" ]]; then
  TIMING_HASURA_HEALTH=$((SECONDS - TIMER_START))
fi

echo ""

# ── 3. Register database sources for each tenant ─────────────────────────────
# Must happen before migrations so Hasura knows about the database.
# pg_add_source is idempotent — safe to run on every start call.
echo "🔌 Registering database sources..."
for TENANT in "${TENANTS[@]}"; do
  echo "   ▶ Registering source: $TENANT"
  curl -sf -X POST "${HASURA_ENDPOINT}/v1/metadata" \
    -H "X-Hasura-Admin-Secret: $HASURA_ADMIN_SECRET" \
    -H "Content-Type: application/json" \
    -d "{
      \"type\": \"pg_add_source\",
      \"args\": {
        \"name\": \"${TENANT}\",
        \"configuration\": {
          \"connection_info\": {
            \"database_url\": {
              \"from_env\": \"PG_DATABASE_URL\"
            },
            \"isolation_level\": \"read-committed\",
            \"use_prepared_statements\": false
          }
        }
      }
    }" > /dev/null && echo "   ✅ Source registered: $TENANT" \
      || echo "   ℹ️  Source already exists: $TENANT (skipping)"
done

echo ""

# ── 4. Apply migrations for each tenant ──────────────────────────────────────
# Tables are created here — must run before metadata deploy.
if [[ "$RESTART_CONTAINERS" != "true" ]]; then
  echo "📂 Applying migrations..."

  if [[ "${#TENANTS[@]}" -eq 1 ]]; then
    # Single tenant — no parallelization overhead needed
    TENANT="${TENANTS[0]}"
    echo "   ▶ Migrating tenant: $TENANT"
    hasura migrate apply \
      --endpoint "${HASURA_ENDPOINT}" \
      --admin-secret "$HASURA_ADMIN_SECRET" \
      --database-name "$TENANT"
    echo "   ✅ Migrations applied for $TENANT"
  else
    # Multiple tenants — run in parallel background jobs
    # Tenants are schema-isolated: no cross-tenant migration dependencies
    MIGRATION_PIDS=()
    MIGRATION_LOGS=$(mktemp -d)

    for TENANT in "${TENANTS[@]}"; do
      (
        hasura migrate apply \
          --endpoint "${HASURA_ENDPOINT}" \
          --admin-secret "$HASURA_ADMIN_SECRET" \
          --database-name "$TENANT" \
          > "$MIGRATION_LOGS/$TENANT.log" 2>&1
      ) &
      MIGRATION_PIDS+=($!)
      echo "   ▶ Migrating tenant: $TENANT (pid ${MIGRATION_PIDS[-1]})"
    done

    MIGRATION_FAILED=()
    for i in "${!MIGRATION_PIDS[@]}"; do
      TENANT="${TENANTS[$i]}"
      if wait "${MIGRATION_PIDS[$i]}"; then
        echo "   ✅ Migrations applied for $TENANT"
      else
        echo "   ❌ Migration failed for $TENANT:"
        cat "$MIGRATION_LOGS/$TENANT.log"
        MIGRATION_FAILED+=("$TENANT")
      fi
    done

    rm -rf "$MIGRATION_LOGS"

    if [[ ${#MIGRATION_FAILED[@]} -gt 0 ]]; then
      echo "❌ Migrations failed for: ${MIGRATION_FAILED[*]}"
      exit 1
    fi
  fi

  if [[ "$TRACK_SAFETRUST_TIMINGS" == "true" ]]; then
    TIMING_MIGRATIONS_SAFETRUST=$((SECONDS - TIMER_START))
  fi
else
  echo "⏭️  --restart: skipping migrations (schema unchanged)"
  TIMING_MIGRATIONS_SAFETRUST=0
fi

echo ""

# ── 5. Deploy tenant metadata AFTER migrations ────────────────────────────────
# Tables now exist in the DB so Hasura can track them successfully.
echo "🏗️  Deploying tenant metadata: ${TENANTS[*]}"

if [[ "${#TENANTS[@]}" -eq 1 ]]; then
  # Single tenant — call setup-tenant.sh directly, no parallelization
  cd metadata
  ./setup-tenant.sh "${TENANTS[0]}" \
    --endpoint "${HASURA_ENDPOINT}" \
    --admin-secret "$HASURA_ADMIN_SECRET"
  cd ..
else
  # Multiple tenants — deploy metadata in parallel background jobs
  # setup-tenant.sh uses mktemp -d internally so parallel runs are safe
  METADATA_PIDS=()
  METADATA_LOGS=$(mktemp -d)

  for TENANT in "${TENANTS[@]}"; do
    (
      cd metadata
      ./setup-tenant.sh "$TENANT" \
        --endpoint "${HASURA_ENDPOINT}" \
        --admin-secret "$HASURA_ADMIN_SECRET" \
        > "$METADATA_LOGS/$TENANT.log" 2>&1
      cd ..
    ) &
    METADATA_PIDS+=($!)
    echo "   ▶ Deploying metadata for $TENANT (pid ${METADATA_PIDS[-1]})"
  done

  METADATA_FAILED=()
  for i in "${!METADATA_PIDS[@]}"; do
    TENANT="${TENANTS[$i]}"
    if wait "${METADATA_PIDS[$i]}"; then
      # Stream the log output after completion so it appears in order
      cat "$METADATA_LOGS/$TENANT.log"
      echo "   ✅ Metadata deployed for $TENANT"
    else
      cat "$METADATA_LOGS/$TENANT.log"
      echo "   ❌ Metadata deployment failed for $TENANT"
      METADATA_FAILED+=("$TENANT")
    fi
  done

  rm -rf "$METADATA_LOGS"

  if [[ ${#METADATA_FAILED[@]} -gt 0 ]]; then
    echo "❌ Metadata deployment failed for: ${METADATA_FAILED[*]}"
    exit 1
  fi
fi

if [[ "$TRACK_SAFETRUST_TIMINGS" == "true" ]]; then
  TIMING_METADATA_DEPLOY_SAFETRUST=$((SECONDS - TIMER_START))
fi

echo ""

# ── 6. Reload metadata after deploy ──────────────────────────────────────────
echo "📋 Reloading metadata..."
hasura metadata reload \
  --endpoint "${HASURA_ENDPOINT}" \
  --admin-secret "$HASURA_ADMIN_SECRET"

if [[ "$TRACK_SAFETRUST_TIMINGS" == "true" ]]; then
  TIMING_METADATA_RELOAD=$((SECONDS - TIMER_START))
fi

echo ""

# ── 7. Apply seeds for each tenant ───────────────────────────────────────────
if [[ "$RESTART_CONTAINERS" != "true" ]]; then
  echo "🌱 Applying seeds..."
  for TENANT in "${TENANTS[@]}"; do
    echo "   ▶ Seeding tenant: $TENANT"
    hasura seed apply \
      --endpoint "${HASURA_ENDPOINT}" \
      --admin-secret "$HASURA_ADMIN_SECRET" \
      --database-name "$TENANT"
    echo "   ✅ Seeds applied for $TENANT"
  done

  if [[ "$TRACK_SAFETRUST_TIMINGS" == "true" ]]; then
    TIMING_SEEDS_SAFETRUST=$((SECONDS - TIMER_START))
    TIMING_TOTAL=$((SECONDS - TIMER_START))
  fi
else
  echo "⏭️  --restart: skipping seeds (data unchanged)"
  TIMING_SEEDS_SAFETRUST=0
  TIMING_TOTAL=$((SECONDS - TIMER_START))
fi

if [[ "$TRACK_SAFETRUST_TIMINGS" == "true" ]]; then
  mkdir -p tests/results
  cat > tests/results/dc-prep-timings.json <<EOF
{
  "docker_up": ${TIMING_DOCKER_UP},
  "hasura_health": ${TIMING_HASURA_HEALTH},
  "migrations_safetrust": ${TIMING_MIGRATIONS_SAFETRUST},
  "metadata_deploy_safetrust": ${TIMING_METADATA_DEPLOY_SAFETRUST},
  "metadata_reload": ${TIMING_METADATA_RELOAD},
  "seeds_safetrust": ${TIMING_SEEDS_SAFETRUST},
  "total": ${TIMING_TOTAL}
}
EOF
fi

# ── Done ──────────────────────────────────────────────────────────────────────
echo ""
echo "✅ SafeTrust backend ready"
echo "   Tenants deployed: ${TENANTS[*]}"
echo "   GraphQL:          ${HASURA_ENDPOINT}/v1/graphql"
echo "   PostgreSQL:       localhost:${POSTGRES_PORT}"
echo "   Webhook:          http://localhost:${WEBHOOK_PORT}"
echo ""
echo "👉 To open Hasura console:"
echo "   hasura console --endpoint ${HASURA_ENDPOINT} --admin-secret $HASURA_ADMIN_SECRET"
