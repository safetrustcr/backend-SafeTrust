#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
ENDPOINT="${HASURA_GRAPHQL_ENDPOINT:-http://graphql-engine-test:8080}"
ADMIN_SECRET="${HASURA_ADMIN_SECRET:-${HASURA_GRAPHQL_ADMIN_SECRET:?Hasura admin secret is required}}"
for ((attempt=0; ; attempt++)); do
  if curl -fsS --connect-timeout 5 --max-time 5 "$ENDPOINT/healthz" >/dev/null; then
    break
  fi
  if ((attempt >= 60)); then
    echo '[migrate-test] Hasura health check timed out' >&2
    exit 1
  fi
  sleep 2
done
for tenant in safetrust hotel_industry; do
  payload=$(jq -cn --arg name "$tenant" '{type:"pg_add_source",args:{name:$name,replace_configuration:true,configuration:{connection_info:{database_url:{from_env:"PG_DATABASE_URL"},isolation_level:"read-committed"}}}}')
  curl -fsS -X POST "$ENDPOINT/v1/metadata" \
    -H "X-Hasura-Admin-Secret: $ADMIN_SECRET" \
    -H 'Content-Type: application/json' -d "$payload" >/dev/null
  echo "[migrate-test] Migrating tenant: $tenant"
  hasura migrate apply --database-name "$tenant" --endpoint "$ENDPOINT" --admin-secret "$ADMIN_SECRET"
done
metadata/setup-tenant.sh safetrust hotel_industry --endpoint "$ENDPOINT" --admin-secret "$ADMIN_SECRET"

echo "[migrate-test] Ensuring analytics functions and permissions are tracked (idempotent)..."

# Helper: call Hasura metadata API, ignore "already exists" / "already tracked" errors,
# but surface any other failure to stderr.
hasura_meta_call() {
  local desc="$1"
  local payload="$2"
  local resp
  resp=$(curl -sS -X POST "$ENDPOINT/v1/metadata" \
    -H "X-Hasura-Admin-Secret: $ADMIN_SECRET" \
    -H 'Content-Type: application/json' \
    -d "$payload")
  local err
  err=$(echo "$resp" | jq -r '.error // ""' 2>/dev/null || true)
  if [ -n "$err" ] && \
     ! echo "$err" | grep -qi "already exists" && \
     ! echo "$err" | grep -qi "already tracked"; then
    echo "[migrate-test] WARNING: $desc: $resp" >&2
  else
    echo "[migrate-test] OK: $desc"
  fi
}

# 1. Track get_escrow_analytics_by_day (idempotent — ignored if already tracked)
hasura_meta_call "track get_escrow_analytics_by_day" "$(jq -cn '{
  type: "pg_track_function",
  args: {
    source: "safetrust",
    function: { schema: "safetrust", name: "get_escrow_analytics_by_day" },
    configuration: { custom_name: "getEscrowAnalyticsByDay", exposed_as: "query" }
  }
}')"

# 2. Grant host permission on get_escrow_analytics_by_day (idempotent)
hasura_meta_call "grant host perm on get_escrow_analytics_by_day" "$(jq -cn '{
  type: "pg_create_function_permission",
  args: {
    source: "safetrust",
    function: { schema: "safetrust", name: "get_escrow_analytics_by_day" },
    role: "host"
  }
}')"

# 3. Track get_escrow_status_summary (idempotent — ignored if already tracked)
hasura_meta_call "track get_escrow_status_summary" "$(jq -cn '{
  type: "pg_track_function",
  args: {
    source: "safetrust",
    function: { schema: "safetrust", name: "get_escrow_status_summary" },
    configuration: { exposed_as: "query" }
  }
}')"

# 4. Grant host permission on get_escrow_status_summary (idempotent)
hasura_meta_call "grant host perm on get_escrow_status_summary" "$(jq -cn '{
  type: "pg_create_function_permission",
  args: {
    source: "safetrust",
    function: { schema: "safetrust", name: "get_escrow_status_summary" },
    role: "host"
  }
}')"

echo "[migrate-test] Reloading Hasura metadata cache..."
curl -fsS -X POST "$ENDPOINT/v1/metadata" \
  -H "X-Hasura-Admin-Secret: $ADMIN_SECRET" \
  -H 'Content-Type: application/json' \
  -d '{"type":"reload_metadata","args":{}}' >/dev/null

echo "[migrate-test] Test database preparation complete!"
