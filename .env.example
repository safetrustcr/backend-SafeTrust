# ── PostgreSQL ───────────────────────────────────────────────
# Required — the stack fails fast when it is missing instead of starting with a
# well-known password. This is the admin role used by migrations only.
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=postgres

# ── Least-privilege roles (created on the first start) ───────
# hasura          Hasura data source — tenant schemas only, never superuser
# hasura_metadata owns the hasura_metadata database (Hasura catalog)
# webhook         webhook — DML on safetrust only, no CREATE
# Use URL-safe passwords (no @, /, :, ?) — they end up in connection URLs.
HASURA_DB_PASSWORD=change-this-hasura-password
HASURA_METADATA_DB_PASSWORD=change-this-metadata-password
WEBHOOK_DB_PASSWORD=change-this-webhook-password

# Postgres is not published by docker-compose.yml. To reach it from a local
# client, copy docker-compose.override.example.yml to docker-compose.override.yml
# (git-ignored); it binds 127.0.0.1:${POSTGRES_PORT} only.
POSTGRES_PORT=5433

# ── Hasura GraphQL Engine ────────────────────────────────────
# Hasura and the webhook bind 127.0.0.1 only; put a reverse proxy in front of
# them to publish them. The Hasura console is served on HASURA_PORT.
HASURA_ENDPOINT=http://localhost:8080
HASURA_PORT=8080
HASURA_GRAPHQL_ADMIN_SECRET=change-this-admin-secret
# The Hasura catalog lives in its own database, owned by the hasura_metadata role.
HASURA_GRAPHQL_METADATA_DATABASE_URL=postgres://hasura_metadata:change-this-metadata-password@postgres:5432/hasura_metadata
HASURA_GRAPHQL_ENABLE_CONSOLE=true
# query-log is off by default: it writes every query and its variables (emails,
# phone numbers, wallet addresses) to the container log. Enable it only while
# debugging.
# HASURA_GRAPHQL_ENABLED_LOG_TYPES=startup, http-log, webhook-log, query-log

# ── Webhook ─────────────────────────────────────────────────
WEBHOOK_PORT=3000

# ── Secrets ─────────────────────────────────────────────────
# In production keep secrets in files instead of the environment. Compose mounts
# them at /run/secrets/… and the webhook reads the *_FILE variants (see
# docker-compose.secrets.example.yml):
# FIREBASE_PRIVATE_KEY_FILE=/run/secrets/firebase_private_key
# TRUSTLESSWORK_API_KEY_FILE=/run/secrets/trustlesswork_api_key
# POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
# Plain variables remain supported for local development:
# FIREBASE_PRIVATE_KEY=
# TRUSTLESSWORK_API_KEY=

# ── Hasura JWT - Firebase RS256 (production) - docs: https://cloud.hasura.io/project/c8ea3a10-38a9-49b1-860c-19ab1df1584d/env-vars
HASURA_GRAPHQL_JWT_SECRET={"type":"RS256","jwk_url":"https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com","audience":"safetrustcr-596e3","issuer":"https://securetoken.google.com/safetrustcr-596e3","claims_namespace":"https://hasura.io/jwt/claims"}
WALLET_CHALLENGE_DOMAIN=localhost
