# ============================================================
# SafeTrust — Backend Environment Variables
# Copy this file to .env and fill in the values marked <...>
#   cp .env_example .env
# ============================================================

# ── Local Development Setup (bin/start) ────────────────────
# These values are used by the unified setup script.
# Override on the command line:
#   bash bin/start --tenant safetrust --endpoint http://localhost:8080 --secret myadminsecretkey
SETUP_HASURA_ENDPOINT=http://localhost:8080
SETUP_ADMIN_SECRET=myadminsecretkey

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=safetrust
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

PG_DATABASE_URL=postgres://postgres:postgrespassword@postgres:5432/safetrust

# ── Hasura GraphQL Engine ────────────────────────────────────
HASURA_ADMIN_SECRET=myadminsecretkey
HASURA_GRAPHQL_ADMIN_SECRET=myadminsecretkey
HASURA_GRAPHQL_METADATA_DATABASE_URL=postgres://postgres:postgrespassword@postgres:5432/postgres
HASURA_GRAPHQL_ENABLED_LOG_TYPES=startup,http-log,webhook-log,websocket-log,query-log
HASURA_GRAPHQL_ENABLE_CONSOLE=true
HASURA_GRAPHQL_CORS_DOMAIN=*

# Firebase JWT validation — replace <project-id> with your Firebase Project ID
# Docs: https://hasura.io/docs/latest/auth/authentication/jwt/
HASURA_GRAPHQL_JWT_SECRET='{"type":"HS256","key":"your-32-char-minimum-secret-key-here"}'

# ── Soroban RPC Reconciler ────────────────────────────────────
# Enable Soroban RPC blockchain validation pass in sync-escrows
# Set to true in Phase 2 after Soroban indexer is stable
# Default: false (non-breaking — TrustlessWork sync still runs)
SOROBAN_VALIDATION_ENABLED=false

# Stellar network for Soroban RPC queries
# Options: testnet, mainnet
STELLAR_NETWORK=testnet

# Override default Soroban RPC endpoint
# Default testnet: https://soroban-testnet.stellar.org
# Default mainnet: https://soroban.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

