# ============================================================
# SafeTrust — Backend Environment Variables
# Copy this file to .env and fill in the values marked <...>
#   cp .env.example .env
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5433

# Number of seed rows per transactional batch (default: 500).
# Lower values reduce the size of a retry; higher values improve throughput.
SEED_CHUNK_SIZE=500

PG_DATABASE_URL=postgres://postgres:postgrespassword@postgres:5432/postgres

# ── Hasura GraphQL Engine ────────────────────────────────────
HASURA_ENDPOINT=http://localhost:8080
HASURA_PORT=8080
HASURA_GRAPHQL_ADMIN_SECRET=myadminsecretkey
HASURA_GRAPHQL_METADATA_DATABASE_URL=postgres://postgres:postgrespassword@postgres:5432/postgres
HASURA_GRAPHQL_ENABLED_LOG_TYPES=startup,http-log,webhook-log,websocket-log,query-log
HASURA_GRAPHQL_ENABLE_CONSOLE=true
HASURA_GRAPHQL_CORS_DOMAIN=*

# Firebase JWT validation — replace <project-id> with your Firebase Project ID
# Docs: https://hasura.io/docs/latest/auth/authentication/jwt/
# Must be valid JSON with a key of at least 32 characters for HS256.
HASURA_GRAPHQL_JWT_SECRET={"type":"HS256","key":"your-32-char-minimum-secret-key-here"}

# Shared secret used to authenticate Hasura event triggers
HASURA_EVENT_SECRET=dev-event-secret

# ── Webhook Service ───────────────────────────────────────────
WEBHOOK_PORT=3000
WEBHOOK_URL=http://safetrust-webhook:3000
NODE_ENV=development

# ── TrustlessWork ─────────────────────────────────────────────
# Base URL + API key for the TrustlessWork escrow API
TRUSTLESSWORK_API_URL=https://dev.api.trustlesswork.com
TRUSTLESSWORK_API_KEY=

# Shared secret used by the webhook handler to authenticate escrow callbacks
TRUSTLESSWORK_WEBHOOK_SECRET=dev-secret



# ── x402 Protocol (Agentic Micropayments) ────────────────────
# Enable x402 payment requirement for AI agent booking workflows
# Default: false — human users unaffected
X402_ENABLED=false
# x402 facilitator endpoint
# Testnet: https://channels.openzeppelin.com/x402/testnet
# Mainnet: https://channels.openzeppelin.com/x402
X402_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
# SafeTrust platform wallet — receives x402 booking fees
SAFETRUST_PLATFORM_WALLET=
