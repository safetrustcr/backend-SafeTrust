# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=postgres
# One database per tenant (created by docker/postgres-init on first volume init).
POSTGRES_SAFETRUST_DB=safetrust
POSTGRES_HOTEL_INDUSTRY_DB=hotel_industry
POSTGRES_HOST=postgres
# Host port; containers connect to PostgreSQL on port 5432 internally.
POSTGRES_PORT=5433

# ── Hasura GraphQL Engine ────────────────────────────────────
HASURA_ENDPOINT=http://localhost:8080
HASURA_PORT=8080
# Required. Generate a strong value and inject it at runtime from your secret
# manager; never commit a real secret. Hasura and the webhook both read this.
HASURA_ADMIN_SECRET=
HASURA_GRAPHQL_METADATA_DATABASE_URL=postgres://postgres:postgrespassword@postgres:5432/postgres
HASURA_GRAPHQL_ENABLE_CONSOLE=true

# ── Hasura JWT - Firebase RS256 (production) - docs: https://cloud.hasura.io/project/c8ea3a10-38a9-49b1-860c-19ab1df1584d/env-vars
HASURA_GRAPHQL_JWT_SECRET={"type":"RS256","jwk_url":"https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com","audience":"safetrustcr-596e3","issuer":"https://securetoken.google.com/safetrustcr-596e3","claims_namespace":"https://hasura.io/jwt/claims"}
WALLET_CHALLENGE_DOMAIN=localhost

# Required when running the webhook with NODE_ENV=production. Store the private
# key in your secret manager in production; literal \n separators are accepted.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Webhook HTTP ─────────────────────────────────────────────
# Browser origins allowed to call the webhook API, comma-separated exact
# origins (scheme://host[:port], no path). Required in production: when unset,
# production allows no browser origin, and other environments allow only
# http(s)://localhost and 127.0.0.1. `*` allows any origin and must be a
# deliberate choice. Example: https://app.safetrust.example
CORS_ALLOWED_ORIGINS=
# debug | info | warn | error | silent. Logs are JSON, one object per line.
LOG_LEVEL=info

# ── Trustless Work ───────────────────────────────────────────
# V1 API base URL: https://dev.api.trustlesswork.com (testnet, default) or
# https://api.trustlesswork.com (mainnet). Read by reconciliation and
# confirm-transaction; sent as the `x-api-key` header. The older
# TRUSTLESS_WORK_API_* spelling still works but logs a warning.
TRUSTLESSWORK_API_URL=https://dev.api.trustlesswork.com
TRUSTLESSWORK_API_KEY=
