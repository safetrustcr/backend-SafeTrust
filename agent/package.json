{
  "name": "@safetrust/booking-agent",
  "version": "0.1.0",
  "private": true,
  "description": "SafeTrust booking agent as an MCP server with x402 payments and spending limits",
  "main": "dist/index.js",
  "bin": {
    "safetrust-booking-agent": "dist/index.js"
  },
  "scripts": {
    "build": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "type-check": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit && node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -p tsconfig.test.json --noEmit",
    "test": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js --runInBand",
    "demo:testnet": "ts-node src/demo-testnet.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@stellar/stellar-sdk": "^17.4.0",
    "@x402/fetch": "^2.32.0",
    "@x402/stellar": "^2.32.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 30000,
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ],
      "^.+\\.jsx?$": [
        "ts-jest",
        {
          "isolatedModules": true,
          "useESM": false
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(uint8array-extras|@exodus|@noble)/)"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
